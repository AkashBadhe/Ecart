{
  "name": "pickbazar-react",
  "version": "9.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "author": "RedQ, Inc.",
  "workspaces": [
    "admin/*",
    "shop"
  ],
  "scripts": {
    "clean": "pnpm -r exec rimraf \"{.next,node_modules,__generated__,.cache,src/graphql/*.d.ts,src/framework/graphql/**/*.d.ts}\" && rimraf node_modules",
    "gql-clean": "pnpm -r exec rimraf \"{__generated__,src/graphql/*.d.ts,src/framework/graphql/**/*.d.ts}\"",
    "dev:shop-rest": "pnpm --filter @pick-bazar/shop dev:rest",
    "build:shop-rest": "pnpm --filter @pick-bazar/shop build:rest",
    "start:shop-rest": "pnpm --filter @pick-bazar/shop start",
    "dev:admin-rest": "pnpm --filter @marvel/admin-rest dev",
    "build:admin-rest": "pnpm --filter @marvel/admin-rest build",
    "start:admin-rest": "pnpm --filter @marvel/admin-rest start",
    "dev:shop-gql": "pnpm --filter @pick-bazar/shop dev:gql",
    "build:shop-gql": "pnpm --filter @pick-bazar/shop build:gql",
    "start:shop-gql": "pnpm --filter @pick-bazar/shop start",
    "dev:admin-gql": "pnpm --filter @marvel/admin-graphql dev",
    "build:admin-gql": "pnpm --filter @marvel/admin-graphql build",
    "start:admin-gql": "pnpm --filter @marvel/admin-graphql start",
    "dev:api-rest": "pnpm --filter @marvel-mock/api-rest start:dev",
    "build:api-rest": "pnpm --filter @marvel-mock/api-rest build",
    "start:api-rest": "pnpm --filter @marvel-mock/api-rest start:prod",
    "dev:api-gql": "pnpm --filter redq-marvel-mock-api start:dev",
    "build:api-gql": "pnpm --filter redq-marvel-mock-api build",
    "start:api-gql": "pnpm --filter redq-marvel-mock-api start:prod",
    "dev:rest": "pnpm -r --parallel --stream --filter @marvel-mock/api-rest --filter @marvel/admin-rest --filter @pick-bazar/shop run dev:rest",
    "dev:gql": "pnpm -r --parallel --stream --filter redq-marvel-mock-api --filter @marvel/admin-graphql --filter @pick-bazar/shop run dev:gql"
  },
  "devDependencies": {
    "prettier": "2.4.0",
    "rimraf": "3.0.2"
  }
}
